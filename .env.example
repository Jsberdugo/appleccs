# Copia este archivo como .env.local y vuelve a compilar.

# URL CSV de la hoja compartida (gviz/tq?tqx=out:csv&headers=1). Vacío usa los productos de prueba.
VITE_SHEET_CSV_URL=

# Cloud name de la cuenta Cloudinary del cliente.
# Permite encontrar la foto por el código del producto, sin pegar enlaces.
VITE_CLOUDINARY_CLOUD=
